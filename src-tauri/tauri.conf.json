{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JavaNavi",
  "version": "0.1.0",
  "identifier": "com.javanavi.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/javanavi-backend.jar": "resources/javanavi-backend.jar",
      "resources/java-runtime": "resources/java-runtime"
