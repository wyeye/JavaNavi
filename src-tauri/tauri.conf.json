{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JavaNavi",
  "version": "0.1.7",
  "identifier": "com.javanavi.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' http://127.0.0.1:*; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "dmg",
      "app",
      "nsis"
    ],
    "publisher": "wyeye",
    "homepage": "https://github.com/wyeye/JavaNavi",
    "category": "DeveloperTool",
    "shortDescription": "JavaNavi Java/React database client",
    "longDescription": "JavaNavi is a Java + React local web and desktop database client. Community: QQ Group 1001949448.",
    "resources": {
      "resources/javanavi-backend.jar": "resources/javanavi-backend.jar",
      "resources/java-runtime": "resources/java-runtime"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg0NDBGMUQ4Q0IwNzYyNjMKUldSallnZkwyUEZBaEprcE9ERkhpaHZ5cUE3bU1jV0V4V0YwakFLWDlhU2lwVHNLTkg5eGEwZXoK",
      "endpoints": [
        "https://github.com/wyeye/JavaNavi/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
