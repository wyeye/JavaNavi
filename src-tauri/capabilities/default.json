{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Default JavaNavi desktop capability for the packaged local webview.",
  "windows": [
    "main",
    "startup-error",
    "about"
  ],
  "permissions": [
    "core:default",
    "allow-desktop-commands"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*",
      "http://localhost:*"
    ]
  }
}
