{
  "name": "javanavi-frontend",
  "private": true,
  "version": "0.2.6",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc && vite build --configLoader runner",
    "build:budget": "npm run build && node scripts/check-bundle-budget.mjs",
    "preview": "vite preview --configLoader runner",
    "test": "node scripts/verify-custom-datasource-utils.mjs && node --experimental-strip-types scripts/verify-open-sql-file-selection.mjs && node scripts/verify-app-version-display.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.2.6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.6.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "antd": "^5.12.0",
    "clsx": "^2.1.0",
    "mermaid": "^11.13.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-resizable": "^3.1.3",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "sql-formatter": "^15.7.0",
    "uuid": "^14.0.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/react-resizable": "^3.0.8",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^5.2.2",
    "vite": "^8.0.10"
  },
  "description": "JavaNavi React frontend behind Java Web compatibility adapters",
  "overrides": {
    "dompurify": "^3.4.1",
    "uuid": "^14.0.0"
  }
}
